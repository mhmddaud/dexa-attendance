# ==============================================================
# Dexa Attendance - Backend environment variables (example)
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
# ==============================================================

# ---- Service ports ----
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
EMPLOYEE_SERVICE_PORT=3002
ATTENDANCE_SERVICE_PORT=3003

# ---- Microservice hosts (used by the API Gateway TCP clients) ----
AUTH_SERVICE_HOST=127.0.0.1
EMPLOYEE_SERVICE_HOST=127.0.0.1
ATTENDANCE_SERVICE_HOST=127.0.0.1

# ---- JWT ----
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=1h

# ---- MySQL databases (Prisma) ----
AUTH_DATABASE_URL="mysql://root:password@localhost:3306/dexa_auth"
EMPLOYEE_DATABASE_URL="mysql://root:password@localhost:3306/dexa_employee"

# ---- Oracle (Attendance Service) ----
ORACLE_USER=DEXA_ATTENDANCE
ORACLE_PASSWORD=your_oracle_password
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1

# ---- Attendance rules ----
# Hour (0-23, server time) at/after which a check-in is marked LATE
ATTENDANCE_LATE_HOUR=8

# ---- Uploads ----
UPLOAD_DIR=uploads

# ---- CORS (frontend origin) ----
CORS_ORIGIN=http://localhost:5173
